GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
JWT_SECRET=change-me-local-secret
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,https://pitch-ground.vercel.app

# Groq: one shared credential, or independent credentials by responsibility.
# Never place any API key in a NEXT_PUBLIC_* frontend variable.
# Existing OPENAI_* settings remain compatible with the OpenAI-compatible endpoint.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
GROQ_QUESTIONS_API_KEY=
GROQ_ANSWERS_API_KEY=
GROQ_COACHING_API_KEY=
GROQ_DEBATE_API_KEY=
# Optional role-specific model names; empty values use GROQ_MODEL.
GROQ_QUESTIONS_MODEL=
GROQ_ANSWERS_MODEL=
GROQ_COACHING_MODEL=
GROQ_DEBATE_MODEL=
LLM_TIMEOUT_SECONDS=45
LLM_MAX_COMPLETION_TOKENS=4096

# Email Service
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# --- ML Pipeline ---
# ML_ANALYZER: 'real' uses local Faster-Whisper (CPU int8), MediaPipe (Face Mesh/Pose),
#              Librosa (prosody/pitch), and linguistic verbatim filler extractors.
ML_ANALYZER=real
WHISPER_MODEL=small
WHISPER_CPU_THREADS=4
FILLER_CPU_THREADS=4
# Optional absolute path to the downloaded waveform filled-pause classifier:
# FILLER_MODEL_DIR=
# Optional absolute path to an audited JSON fusion policy; bundled policy is uncalibrated.
# SCORING_POLICY_PATH=
DEMO_AUTH=1

# AI opponent voice (backend only; never use NEXT_PUBLIC for these).
SARVAM_API_KEY=
SARVAM_TTS_MODEL=bulbul:v3
# Leave empty for the provider default voice for the selected model.
SARVAM_TTS_SPEAKER=

# --- Database ---
# Explicit local development database (no automatic fallback):
# DATABASE_URL=sqlite:///./data/pitchground.db
# Nhost Postgres (paste from Nhost → Settings → Database):
# DATABASE_URL=postgresql://postgres:PASSWORD@HOST:5432/postgres

# --- Media storage ---
# local = backend/data/media (default)
# nhost = Nhost Storage bucket
STORAGE_BACKEND=local
NHOST_SUBDOMAIN=
NHOST_REGION=
NHOST_ADMIN_SECRET=
NHOST_STORAGE_BUCKET=attempt-media
