GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
JWT_SECRET=change-me-local-secret
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,https://pitch-ground.vercel.app

SARVAM_API_KEY=

# LLM: OpenAI or Groq
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=openai/gpt-oss-120b

# Email Service
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# --- ML Pipeline ---
# ML_ANALYZER: 'real' uses local Faster-Whisper (CPU int8), MediaPipe (Face Mesh/Pose),
#              Librosa (prosody/pitch), and linguistic verbatim filler extractors.
#              'stub' uses deterministic mock signals (low-resource fallback).
ML_ANALYZER=real
DEMO_AUTH=1

# --- Database ---
# Local fallback (SQLite file):
# DATABASE_URL=sqlite:///./data/pitchground.db
# Nhost Postgres (paste from Nhost → Settings → Database):
# DATABASE_URL=postgresql://postgres:PASSWORD@HOST:5432/postgres

# --- Media storage ---
# local = backend/data/media (default)
# nhost = Nhost Storage bucket
STORAGE_BACKEND=local
NHOST_SUBDOMAIN=
NHOST_REGION=
NHOST_ADMIN_SECRET=
NHOST_STORAGE_BUCKET=attempt-media
