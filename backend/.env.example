GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
JWT_SECRET=change-me-local-secret
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,https://pitch-ground.vercel.app

SARVAM_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

ML_ANALYZER=stub
DEMO_AUTH=1

# --- Database ---
# Local fallback (SQLite file):
# DATABASE_URL=sqlite:///./data/pitchground.db
# Nhost Postgres (paste from Nhost → Settings → Database):
# DATABASE_URL=postgresql://postgres:PASSWORD@HOST:5432/postgres
# (postgres:// and postgresql:// are auto-normalized to postgresql+psycopg://)

# --- Media storage ---
# local = backend/data/media (default)
# nhost = Nhost Storage bucket
STORAGE_BACKEND=local
NHOST_SUBDOMAIN=
NHOST_REGION=
NHOST_ADMIN_SECRET=
NHOST_STORAGE_BUCKET=attempt-media
